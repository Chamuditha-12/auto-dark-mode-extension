{
  "manifest_version": 3,
  "name": "Auto Dark Mode",
  "version": "1.0",
  "description": "Automatically makes all white pages dark",
  "permissions": ["storage"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "css": ["dark.css"],
      "run_at": "document_start"
    }
  ]
}
